{
  "name": "provoware-datenbanktool-foundation",
  "private": true,
  "version": "0.5.2-alpha.1",
  "scripts": {
    "format": "prettier --write \"src/web/**/*.{html,js,css,json}\" \"src/config/**/*.json\" MANIFEST.json VERSION.json TOOL_SCHEMA.json \"tests/browser/**/*.js\" playwright.config.js",
    "format:check": "prettier --check \"src/web/**/*.{html,js,css,json}\" \"src/config/**/*.json\" MANIFEST.json VERSION.json TOOL_SCHEMA.json \"tests/browser/**/*.js\" playwright.config.js",
    "browser:smoke": "playwright test",
    "browser:smoke:chrome": "PW_CHANNEL=chrome playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "prettier": "3.3.3"
  }
}
