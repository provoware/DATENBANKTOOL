{
  "schema_version": 1,
  "project": {
    "name": "PROVOWARE DATENBANKTOOL",
    "version": "0.5.0-alpha.1",
    "status": "restorekern",
    "language": "de",
    "offline_first": true
  },
  "architecture": {
    "layers": ["ui", "api", "application", "persistence", "recovery", "backup", "logging"],
    "separation": {
      "base_tool": "src/",
      "default_config": "src/config/",
      "public_config_examples": "config/",
      "user_data": "data/user/",
      "runtime": "runtime/",
      "logs": "logs/",
      "backups": "backups/",
      "tests": "tests/",
      "tools": "tools/"
    }
  },
  "persistence": {
    "engine": "sqlite3",
    "default_path": "data/user/provoware.sqlite3",
    "schema_version": 1,
    "journal_mode": "WAL",
    "foreign_keys": true,
    "busy_timeout_ms": 5000,
    "migration_policy": "forward-only",
    "migration_checksum": "sha256",
    "integrity_checks": ["quick_check", "foreign_key_check"],
    "exclusive_restore_access_gate": true
  },
  "recovery": {
    "contract_version": 1,
    "flow": ["PRECHECK", "MUTATION", "POSTCHECK", "COMMIT_OR_ROLLBACK", "EVIDENCE"],
    "states": [
      "RECEIVED",
      "PRECHECK",
      "MUTATION",
      "POSTCHECK",
      "COMMITTING",
      "COMMITTED",
      "ROLLING_BACK",
      "ROLLED_BACK",
      "REJECTED",
      "FAILED"
    ],
    "single_writer_gate": true,
    "idempotency_key_hash": "sha256",
    "startup_incomplete_operation_gate": true,
    "machine_journal": "runtime/recovery/recovery_journal_status_laufend.jsonl",
    "final_evidence_directory": "runtime/recovery/evidence/",
    "evidence_schema_version": 1,
    "sensitive_details_redacted": true
  },
  "backup": {
    "contract_version": 1,
    "manifest_version": 1,
    "engine": "sqlite_backup_api",
    "supports_wal_source": true,
    "backup_id_prefix": "bkp-",
    "staging_prefix": ".incomplete_",
    "verified_prefix": "backup_status_verified_",
    "database_filename": "database.sqlite3",
    "manifest_filename": "backup_manifest.json",
    "hash": "sha256",
    "required_manifest_fields": [
      "manifest_version",
      "backup_id",
      "status",
      "created_at_utc",
      "database_file",
      "sha256",
      "size_bytes",
      "schema_version",
      "integrity_ok",
      "quick_check",
      "foreign_key_violations"
    ],
    "verification_checks": ["sha256", "size_bytes", "schema_version", "quick_check", "foreign_key_check"],
    "atomic_publish_after_verification": true,
    "incomplete_backup_is_valid": false,
    "restore_enabled": true
  },
  "restore": {
    "contract_version": 1,
    "flow": [
      "BACKUP_VERIFY",
      "RESTORE_STAGING",
      "STAGING_VERIFY",
      "ROLLBACK_SNAPSHOT",
      "SWAP_PREPARED",
      "SWAPPING",
      "SWAPPED",
      "POSTCHECK",
      "COMMITTED_OR_ROLLED_BACK",
      "EVIDENCE"
    ],
    "staging_directory": "runtime/recovery/restore_staging/",
    "rollback_directory": "runtime/recovery/restore_rollback/",
    "verification_checks": ["sha256", "schema_version", "quick_check", "foreign_key_check"],
    "backup_reverified_before_restore": true,
    "product_untouched_before_swap": true,
    "exclusive_database_access_during_swap": true,
    "atomic_swap": "os.replace",
    "postcheck_required_before_commit": true,
    "rollback_on_postcheck_failure": true,
    "crash_boundary_state": "SWAPPING",
    "startup_gate_blocks_incomplete_restore": true,
    "explicit_confirmation_required": "DATENBANK WIEDERHERSTELLEN"
  },
  "file_limits": {
    "python": {
      "preferred_lines": 300,
      "max_lines": 450,
      "preferred_line_length": 100,
      "max_line_length": 120
    },
    "javascript": {
      "preferred_lines": 320,
      "max_lines": 450,
      "preferred_line_length": 110,
      "max_line_length": 140
    },
    "css": {
      "preferred_lines": 400,
      "max_lines": 650,
      "preferred_line_length": 100,
      "max_line_length": 140
    },
    "html": {
      "preferred_lines": 450,
      "max_lines": 650,
      "preferred_line_length": 120,
      "max_line_length": 160
    },
    "markdown": {
      "preferred_lines": 350,
      "max_lines": 600,
      "preferred_line_length": 100,
      "max_line_length": 140
    },
    "json": {
      "preferred_lines": 400,
      "max_lines": 800,
      "preferred_line_length": 120,
      "max_line_length": 180
    }
  },
  "logging": {
    "schema_version": 1,
    "machine_format": "jsonl",
    "human_format": "txt",
    "levels": ["DEBUG", "INFO", "WARN", "ERROR", "CRITICAL"],
    "max_jsonl_lines_per_file": 2500,
    "max_jsonl_bytes_per_file": 2097152,
    "max_short_report_lines": 120,
    "max_detail_chars": 2000,
    "max_detail_total_chars": 8000,
    "redact_keys": ["password", "passwort", "token", "secret", "api_key", "authorization", "cookie", "credential"]
  },
  "quality": {
    "python_formatter": "ruff format",
    "python_linter": "ruff check",
    "web_formatter": "prettier",
    "test_runner": "pytest",
    "project_checker": "python tools/check_project.py",
    "release_blocking": ["syntax", "format", "tests", "file_limits", "manifest", "regressions_p0"]
  },
  "ui": {
    "language": "de",
    "minimum_focus_visibility": true,
    "color_only_status_forbidden": true,
    "tooltips_optional_support_only": true,
    "zoom_target_percent": [100, 125, 150, 200],
    "semantic_colors": {
      "success": "#50e38a",
      "warning": "#ffd24a",
      "error": "#ff667a",
      "info": "#8d7dff",
      "primary": "#35e1dc"
    }
  }
}
