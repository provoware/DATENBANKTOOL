{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROVOWARE Log Event",
  "type": "object",
  "required": ["schema_version", "session_id", "event_id", "timestamp", "level", "code", "component", "summary", "action", "details"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string"},
    "event_id": {"type": "string"},
    "timestamp": {"type": "string"},
    "level": {"enum": ["DEBUG", "INFO", "WARN", "ERROR", "CRITICAL"]},
    "code": {"type": "string"},
    "component": {"type": "string"},
    "summary": {"type": "string"},
    "action": {"type": "string"},
    "details": {"type": "object"}
  }
}
